# Copy this file to .env. Never commit the real key.
OPENAI_API_KEY=replace-with-your-api-key

# OpenAI-compatible API endpoint and swappable models.
OPENAI_BASE_URL=https://api.openai.com/v1
JOURNEYBACK_LLM_MODEL=gpt-5.4-nano
JOURNEYBACK_EMBEDDING_MODEL=text-embedding-3-small

# Customer-facing latency/cost controls.
JOURNEYBACK_REASONING_EFFORT=low
JOURNEYBACK_RAG_TOP_K=8
JOURNEYBACK_LLM_TIMEOUT=60
