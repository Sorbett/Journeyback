# Copy this file to .env. Never commit real keys.

# DeepSeek handles operational fact extraction and grounded guidance.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
JOURNEYBACK_LLM_PROVIDER=deepseek
JOURNEYBACK_LLM_MODEL=deepseek-v4-flash

# SiliconFlow-hosted BGE-M3 handles semantic embeddings for policy retrieval.
SILICONFLOW_API_KEY=replace-with-your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
JOURNEYBACK_EMBEDDING_PROVIDER=siliconflow
JOURNEYBACK_EMBEDDING_MODEL=BAAI/bge-m3

# Customer-facing latency/cost controls.
JOURNEYBACK_REASONING_EFFORT=low
JOURNEYBACK_RAG_TOP_K=8
JOURNEYBACK_LLM_TIMEOUT=60
